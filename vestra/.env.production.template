# ═══════════════════════════════════════════════════════════════════════════════
# VESTRA — Production Environment Variables Template
# AI-Powered Property Trust & Operating System for Africa
# Version: 4.0.0
# ═══════════════════════════════════════════════════════════════════════════════
#
# HOW TO USE:
#   1. Copy this file to .env:  cp .env.production.template .env
#   2. Replace ALL values marked [REQUIRED] with real secrets
#   3. NEVER commit the filled .env to version control
#   4. For cloud deploys (Fly.io/Render), set each as an environment variable
#
# SECURITY NOTES:
#   - Run `python -c "import secrets; print(secrets.token_hex(32))"` for random keys
#   - Rotate secrets quarterly
#   - All passwords should be 20+ characters with mixed case, numbers, symbols
#   - Never use the same secret across environments (dev/staging/prod)
# ═══════════════════════════════════════════════════════════════════════════════

# ##############################################################################
# SECTION 1: CORE APPLICATION
# ##############################################################################

# Application name — used in emails, titles, metadata
# ═══════════════════════════════════════════════════════════════════════════════
APP_NAME=Vestra

# Application version — follows semver, update on each release
# ═══════════════════════════════════════════════════════════════════════════════
APP_VERSION=4.0.0

# Deployment environment
# Values: development | staging | production
# ═══════════════════════════════════════════════════════════════════════════════
ENVIRONMENT=production

# [REQUIRED] Public-facing base URL of the application
# Used in email links, payment callbacks, social share images
# No trailing slash
# ═══════════════════════════════════════════════════════════════════════════════
BASE_URL=https://vestra.co.ke

# [REQUIRED] Comma-separated list of allowed CORS origins
# Include all domains that will make browser requests to the API
# ═══════════════════════════════════════════════════════════════════════════════
CORS_ORIGINS=https://vestra.co.ke,https://app.vestra.co.ke,https://www.vestra.co.ke

# Debug mode — MUST be false in production
# ═══════════════════════════════════════════════════════════════════════════════
DEBUG=false

# ##############################################################################
# SECTION 2: DATABASE (PostgreSQL)
# ##############################################################################

# [REQUIRED] Full PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname?ssl=require
# IMPORTANT: Must include ?ssl=require or ?ssl=verify-full in production
# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE_URL=postgresql+asyncpg://vestra:YOUR_PASSWORD@vestra-db.internal:5432/vestra?ssl=require

# [REQUIRED] PostgreSQL user password (used by docker-compose, separate from DATABASE_URL)
# ═══════════════════════════════════════════════════════════════════════════════
POSTGRES_PASSWORD=CHANGE-ME-TO-STRONG-RANDOM-PASSWORD-AT-LEAST-20-CHARS

# PostgreSQL user (default: postgres)
# ═══════════════════════════════════════════════════════════════════════════════
POSTGRES_USER=postgres

# Database connection pool size
# Tune based on available RAM: ~20 per GB of RAM
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_POOL_SIZE=20

# Maximum pool overflow connections (burst allowance above pool size)
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_MAX_OVERFLOW=40

# Connection recycle time in seconds — prevents stale connections
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_POOL_RECYCLE=3600

# ##############################################################################
# SECTION 3: REDIS (Cache, Sessions, Rate Limiting, Queues)
# ##############################################################################

# [REQUIRED] Redis connection URL
# ═══════════════════════════════════════════════════════════════════════════════
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis-host:6379/0

# [REQUIRED] Redis password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ═══════════════════════════════════════════════════════════════════════════════
REDIS_PASSWORD=CHANGE-ME-TO-STRONG-RANDOM-PASSWORD

# Maximum Redis client connections from the application
# ═══════════════════════════════════════════════════════════════════════════════
REDIS_MAX_CONNECTIONS=50

# ##############################################################################
# SECTION 4: AUTHENTICATION & SECURITY
# ##############################################################################

# [REQUIRED] JWT signing secret — must be at least 64 characters
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# ═══════════════════════════════════════════════════════════════════════════════
SECRET_KEY=CHANGE-ME-TO-64-CHAR-CRYPTOGRAPHICALLY-RANDOM-STRING

# JWT signing algorithm
# ═══════════════════════════════════════════════════════════════════════════════
ALGORITHM=HS256

# Access token lifetime in minutes (default: 60 = 1 hour)
# ═══════════════════════════════════════════════════════════════════════════════
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token lifetime in days (default: 7)
# ═══════════════════════════════════════════════════════════════════════════════
REFRESH_TOKEN_EXPIRE_DAYS=7

# [REQUIRED] Encryption key for sensitive data at rest (Fernet symmetric key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ═══════════════════════════════════════════════════════════════════════════════
ENCRYPTION_KEY=

# Content Security Policy — enables strict CSP headers
# ═══════════════════════════════════════════════════════════════════════════════
CSP_ENABLED=true

# CSRF protection — enables CSRF token validation
# ═══════════════════════════════════════════════════════════════════════════════
CSRF_ENABLED=true

# Session idle timeout in minutes — auto-logout after inactivity
# ═══════════════════════════════════════════════════════════════════════════════
SESSION_IDLE_TIMEOUT_MINUTES=30

# Maximum concurrent sessions per user
# ═══════════════════════════════════════════════════════════════════════════════
MAX_CONCURRENT_SESSIONS=5

# Account lockout — max failed login attempts before temporary ban
# ═══════════════════════════════════════════════════════════════════════════════
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5

# Account lockout duration in minutes
# ═══════════════════════════════════════════════════════════════════════════════
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# CAPTCHA Security (Cloudflare Turnstile)
# Sign up: https://dash.cloudflare.com/sign-up/turnstile
# ═══════════════════════════════════════════════════════════════════════════════
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ##############################################################################
# SECTION 5: PAYMENT GATEWAYS
# ##############################################################################

# ── 5a. M-Pesa Daraja API (Kenya) ─────────────────────────────────────────────
# Register: https://developer.safaricom.co.ke/
#
# [REQUIRED] M-Pesa consumer key (from Safaricom developer portal)
# ═══════════════════════════════════════════════════════════════════════════════
MPESA_CONSUMER_KEY=

# [REQUIRED] M-Pesa consumer secret (from Safaricom developer portal)
# ═══════════════════════════════════════════════════════════════════════════════
MPESA_CONSUMER_SECRET=

# M-Pesa shortcode / till number
# Sandbox: 174379 | Production: your actual paybill/till number
# ═══════════════════════════════════════════════════════════════════════════════
MPESA_SHORTCODE=174379

# [REQUIRED] M-Pesa passkey (from Safaricom developer portal)
# ═══════════════════════════════════════════════════════════════════════════════
MPESA_PASSKEY=

# [REQUIRED] M-Pesa callback URL (must be HTTPS, publicly accessible)
# ═══════════════════════════════════════════════════════════════════════════════
MPESA_CALLBACK_URL=https://vestra.co.ke/api/payments/mpesa/callback

# M-Pesa environment
# Values: sandbox (testing) | production (live transactions)
# ═══════════════════════════════════════════════════════════════════════════════
MPESA_ENV=production

# ── 5b. Stripe (Global Cards) ─────────────────────────────────────────────────

# [REQUIRED if using Stripe] Stripe secret key (sk_live_...)
# Get from: https://dashboard.stripe.com/apikeys
# ═══════════════════════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=

# [REQUIRED if using Stripe] Stripe webhook signing secret (whsec_...)
# Get from: https://dashboard.stripe.com/webhooks
# ═══════════════════════════════════════════════════════════════════════════════
STRIPE_WEBHOOK_SECRET=

# ── 5c. PayPal ────────────────────────────────────────────────────────────────

# PayPal client ID
# Get from: https://developer.paypal.com/dashboard/applications
# ═══════════════════════════════════════════════════════════════════════════════
PAYPAL_CLIENT_ID=

# PayPal client secret
# ═══════════════════════════════════════════════════════════════════════════════
PAYPAL_CLIENT_SECRET=

# PayPal environment
# Values: sandbox | live
# ═══════════════════════════════════════════════════════════════════════════════
PAYPAL_ENV=live

# ── 5d. Airtel Money (Kenya) ──────────────────────────────────────────────────
# Register: https://developers.airtel.africa/

# Airtel Money client ID
# ═══════════════════════════════════════════════════════════════════════════════
AIRTEL_CLIENT_ID=

# Airtel Money client secret
# ═══════════════════════════════════════════════════════════════════════════════
AIRTEL_CLIENT_SECRET=

# Airtel Money environment
# Values: sandbox | production
# ═══════════════════════════════════════════════════════════════════════════════
AIRTEL_ENV=production

# Airtel Money callback URL (must be HTTPS)
# ═══════════════════════════════════════════════════════════════════════════════
AIRTEL_CALLBACK_URL=https://vestra.co.ke/api/payments/airtel/callback

# ── 5e. Cryptocurrency (Polygon/USDT) ─────────────────────────────────────────

# USDT (ERC-20/Polygon) wallet address for receiving crypto payments
# ═══════════════════════════════════════════════════════════════════════════════
CRYPTO_WALLET_ADDRESS_USDT=

# RPC endpoint for blockchain queries
# ═══════════════════════════════════════════════════════════════════════════════
CRYPTO_RPC_URL=https://polygon-rpc.com

# Enable cryptocurrency payment method on the platform
# ═══════════════════════════════════════════════════════════════════════════════
CRYPTO_ENABLED=false

# ── 5f. Bank Transfer (Kenya) ─────────────────────────────────────────────────

# Registered business name for bank transfers
# ═══════════════════════════════════════════════════════════════════════════════
BANK_ACCOUNT_NAME=Vestra Technologies Ltd

# Bank account numbers by bank (at least one required for bank transfer payments)
# ═══════════════════════════════════════════════════════════════════════════════
BANK_ACCOUNT_NUMBER_KCB=
BANK_ACCOUNT_NUMBER_EQUITY=
BANK_ACCOUNT_NUMBER_COOP=
BANK_ACCOUNT_NUMBER_NCBA=
BANK_ACCOUNT_NUMBER_ABSA=

# ##############################################################################
# SECTION 6: NOTIFICATIONS & COMMUNICATIONS
# ##############################################################################

# ── 6a. Email (SMTP) ─────────────────────────────────────────────────────────

# [REQUIRED] SMTP server hostname
# Common: smtp.gmail.com, smtp.sendgrid.net, email-smtp.us-east-1.amazonaws.com
# ═══════════════════════════════════════════════════════════════════════════════
SMTP_HOST=

# SMTP server port
# 587 (TLS) or 465 (SSL)
# ═══════════════════════════════════════════════════════════════════════════════
SMTP_PORT=587

# [REQUIRED] SMTP authentication username
# ═══════════════════════════════════════════════════════════════════════════════
SMTP_USER=

# [REQUIRED] SMTP authentication password
# For Gmail: use an App Password, NOT your regular password
# ═══════════════════════════════════════════════════════════════════════════════
SMTP_PASSWORD=

# Sender email address
# ═══════════════════════════════════════════════════════════════════════════════
SMTP_FROM_EMAIL=noreply@vestra.co.ke

# Sender display name
# ═══════════════════════════════════════════════════════════════════════════════
SMTP_FROM_NAME=Vestra

# ── 6b. WhatsApp Business API ─────────────────────────────────────────────────
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api

# WhatsApp Business phone number ID (from Meta Business Manager)
# ═══════════════════════════════════════════════════════════════════════════════
WHATSAPP_PHONE_NUMBER_ID=

# [REQUIRED for WhatsApp] Permanent access token
# Generate from: https://developers.facebook.com/apps/YOUR_APP_ID/whatsapp-business/wa-dev-console
# ═══════════════════════════════════════════════════════════════════════════════
WHATSAPP_ACCESS_TOKEN=

# [REQUIRED for WhatsApp] Webhook verification token (any random string you choose)
# ═══════════════════════════════════════════════════════════════════════════════
WHATSAPP_VERIFY_TOKEN=

# WhatsApp Business ID (from Meta Business Manager)
# ═══════════════════════════════════════════════════════════════════════════════
WHATSAPP_BUSINESS_ID=

# WhatsApp app secret (from Meta Developer Portal)
# ═══════════════════════════════════════════════════════════════════════════════
WHATSAPP_APP_SECRET=

# ##############################################################################
# SECTION 7: FILE STORAGE & UPLOADS
# ##############################################################################

# Directory for uploaded files (on-disk storage)
# For cloud deployments, mount a persistent volume at this path
# ═══════════════════════════════════════════════════════════════════════════════
UPLOAD_DIR=./uploads

# Maximum upload file size in bytes (default: 10MB)
# ═══════════════════════════════════════════════════════════════════════════════
MAX_FILE_SIZE=10485760

# Allowed upload MIME types (comma-separated)
# ═══════════════════════════════════════════════════════════════════════════════
# ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png,application/msword

# ##############################################################################
# SECTION 8: RATE LIMITING
# ##############################################################################

# Max authentication requests per minute per IP (login, register, password reset)
# ═══════════════════════════════════════════════════════════════════════════════
RATE_LIMIT_AUTH_PER_MINUTE=10

# Max general API requests per minute per IP
# ═══════════════════════════════════════════════════════════════════════════════
RATE_LIMIT_GENERAL_PER_MINUTE=120

# Max admin API requests per minute per admin user
# ═══════════════════════════════════════════════════════════════════════════════
RATE_LIMIT_ADMIN_PER_MINUTE=300

# ##############################################################################
# SECTION 9: MONITORING & OBSERVABILITY
# ##############################################################################

# ── 9a. Sentry (Error Tracking) ───────────────────────────────────────────────
# Sign up: https://sentry.io/signup/
# Get DSN from: https://sentry.io/settings/projects/YOUR_PROJECT/keys/

# Backend Sentry DSN
# ═══════════════════════════════════════════════════════════════════════════════
SENTRY_DSN=

# Backend trace sample rate (0.0 = none, 1.0 = all)
# ═══════════════════════════════════════════════════════════════════════════════
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend Sentry DSN (public, embedded in client bundle)
# ═══════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SENTRY_DSN=

# ── 9b. Prometheus Metrics ────────────────────────────────────────────────────

# Enable Prometheus metrics endpoint (/metrics)
# ═══════════════════════════════════════════════════════════════════════════════
PROMETHEUS_ENABLED=true

# ── 9c. Health Check ──────────────────────────────────────────────────────────

# [REQUIRED if health checks are authenticated] Health check auth token
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Pass as ?token=YOUR_TOKEN or X-Health-Check-Token header
# ═══════════════════════════════════════════════════════════════════════════════
HEALTH_CHECK_TOKEN=

# ── 9d. Grafana (Monitoring Dashboard) ────────────────────────────────────────

# [REQUIRED if using Grafana] Grafana admin password
# ═══════════════════════════════════════════════════════════════════════════════
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-TO-STRONG-PASSWORD

# Grafana admin username (default: admin)
# ═══════════════════════════════════════════════════════════════════════════════
GRAFANA_ADMIN_USER=admin

# Grafana public-facing URL (if different from main app)
# ═══════════════════════════════════════════════════════════════════════════════
GRAFANA_ROOT_URL=https://monitoring.vestra.co.ke

# ── 9e. Alerting ──────────────────────────────────────────────────────────────

# Alert email recipients (comma-separated for multiple)
# ═══════════════════════════════════════════════════════════════════════════════
ALERT_EMAIL=ops@vestra.co.ke
ALERT_CRITICAL_EMAIL=oncall@vestra.co.ke
ALERT_PERF_EMAIL=engineering@vestra.co.ke
ALERT_BIZ_EMAIL=product@vestra.co.ke

# ##############################################################################
# SECTION 10: GUNICORN (WSGI Server)
# ##############################################################################

# Number of Gunicorn worker processes
# Formula: (2 * CPU_COUNT) + 1  — for 2 CPUs: 5 workers
# ═══════════════════════════════════════════════════════════════════════════════
GUNICORN_WORKERS=5

# Gunicorn bind address (default: all interfaces port 8000)
# ═══════════════════════════════════════════════════════════════════════════════
GUNICORN_BIND=0.0.0.0:8000

# Maximum number of pending connections
# ═══════════════════════════════════════════════════════════════════════════════
GUNICORN_BACKLOG=2048

# Maximum number of simultaneous clients per worker
# ═══════════════════════════════════════════════════════════════════════════════
GUNICORN_WORKER_CONNECTIONS=1000

# Max requests per worker before recycling (prevents memory leaks)
# ═══════════════════════════════════════════════════════════════════════════════
GUNICORN_MAX_REQUESTS=10000
GUNICORN_MAX_REQUESTS_JITTER=1000

# Worker timeout in seconds (max time to process a request)
# ═══════════════════════════════════════════════════════════════════════════════
GUNICORN_TIMEOUT=30

# Graceful timeout in seconds (time to finish existing requests on shutdown)
# ═══════════════════════════════════════════════════════════════════════════════
GUNICORN_GRACEFUL_TIMEOUT=10

# Keepalive connection timeout in seconds
# ═══════════════════════════════════════════════════════════════════════════════
GUNICORN_KEEPALIVE=5

# Gunicorn log level
# Values: debug | info | warning | error | critical
# ═══════════════════════════════════════════════════════════════════════════════
GUNICORN_LOG_LEVEL=info

# ##############################################################################
# SECTION 11: CELERY (Background Task Queue)
# ##############################################################################

# Celery broker URL (typically Redis, using DB 1 to separate from cache)
# ═══════════════════════════════════════════════════════════════════════════════
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1

# Celery result backend (typically Redis, using DB 2)
# ═══════════════════════════════════════════════════════════════════════════════
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2

# Number of background worker processes
# ═══════════════════════════════════════════════════════════════════════════════
WORKERS=4

# Background job batch size (records processed per batch)
# ═══════════════════════════════════════════════════════════════════════════════
BATCH_SIZE=5

# ##############################################################################
# SECTION 12: WEB PUSH NOTIFICATIONS
# ##############################################################################

# [REQUIRED for push notifications] VAPID public key
# Generate with: npx web-push generate-vapid-keys
# ═══════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# VAPID private key (server-side only, never expose to client)
# ═══════════════════════════════════════════════════════════════════════════════
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@vestra.co.ke

# ##############################################################################
# SECTION 13: FRONTEND (Next.js Public Variables)
# ##############################################################################

# [REQUIRED] Backend API URL (publicly accessible from browser)
# ═══════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=https://vestra.co.ke

# Frontend base URL (used for sitemap, SEO metadata)
# ═══════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_BASE_URL=https://vestra.co.ke

# Frontend app name (displayed in browser title, meta tags)
# ═══════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_APP_NAME=Vestra

# Frontend app version (shown in footer, meta tags)
# ═══════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_APP_VERSION=4.0.0

# WebSocket URL for real-time features (notifications, chat, live updates)
# ═══════════════════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_WS_URL=wss://vestra.co.ke

# Google Analytics Measurement ID (optional)
# ═══════════════════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible Analytics domain (optional, privacy-focused alternative)
# ═══════════════════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=vestra.co.ke

# ##############################################################################
# SECTION 14: FEATURE FLAGS
# ##############################################################################

# Enable cryptocurrency feature in the frontend
# ═══════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_ENABLE_CRYPTO=false

# Enable WhatsApp integration in the frontend
# ═══════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_ENABLE_WHATSAPP=false

# Enable AI chat assistant in the frontend
# ═══════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_ENABLE_AI_CHAT=true

